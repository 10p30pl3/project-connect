{
  "type": "object",
  "properties": {
    "attemptId": {
      "type": "string",
      "format": "uuid"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "connectionId": {
      "type": "string",
      "format": "uuid"
    },
    "workspaceId": {
      "type": "string",
      "format": "uuid"
    },
    "to": {
      "type": "string",
      "pattern": "^\\+?[0-9]{8,15}$"
    },
    "from": {
      "type": "string",
      "pattern": "^\\+?[0-9]{8,15}$"
    },
    "callerId": {
      "type": "string",
      "pattern": "^\\+?[0-9]{8,15}$"
    },
    "callerIdPool": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\+?[0-9]{8,15}$"
      }
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "contact": {
      "type": "object",
      "properties": {
        "externalId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "variables": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "externalId",
        "name",
        "variables"
      ],
      "additionalProperties": false
    },
    "campaign": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxDurationSec": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600
        }
      },
      "required": [
        "maxDurationSec"
      ],
      "additionalProperties": false
    },
    "allowedTabulations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "trunkIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 50
    },
    "agentOverrides": {
      "type": "object",
      "properties": {
        "greeting": {
          "type": "string",
          "maxLength": 1000
        },
        "instructionsAppend": {
          "type": "string",
          "maxLength": 4000
        },
        "voice": {
          "type": "string",
          "maxLength": 80
        },
        "maxDurationSec": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600
        },
        "callerIdStrategy": {
          "type": "string",
          "enum": [
            "FIXED",
            "LOCAL_PRESENCE_DDD",
            "ROUND_ROBIN"
          ]
        },
        "idleTimeoutSeconds": {
          "type": "integer",
          "minimum": 3,
          "maximum": 30
        }
      },
      "additionalProperties": false
    },
    "agentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "agentSource": {
      "type": "string",
      "enum": [
        "campaign_override",
        "channel_default",
        "workspace_default"
      ]
    },
    "trunkSource": {
      "type": "string",
      "enum": [
        "campaign_override",
        "outbound_route",
        "channel_default"
      ]
    },
    "callback": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "secret": {
          "type": "string",
          "minLength": 16
        }
      },
      "required": [
        "url",
        "secret"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "attemptId",
    "traceId",
    "connectionId",
    "workspaceId",
    "to",
    "from",
    "callerId",
    "tenantId",
    "contact",
    "campaign",
    "limits",
    "callback"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
