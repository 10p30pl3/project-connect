{
  "type": "object",
  "properties": {
    "attemptId": {
      "type": "string",
      "format": "uuid"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "connectionId": {
      "type": "string",
      "format": "uuid"
    },
    "workspaceId": {
      "type": "string",
      "format": "uuid"
    },
    "to": {
      "type": "string",
      "pattern": "^\\+?[0-9]{8,15}$"
    },
    "from": {
      "type": "string",
      "pattern": "^\\+?[0-9]{8,15}$"
    },
    "callerId": {
      "type": "string",
      "pattern": "^\\+?[0-9]{8,15}$"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "contact": {
      "type": "object",
      "properties": {
        "externalId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "variables": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "externalId",
        "name",
        "variables"
      ],
      "additionalProperties": false
    },
    "campaign": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxDurationSec": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600
        }
      },
      "required": [
        "maxDurationSec"
      ],
      "additionalProperties": false
    },
    "allowedTabulations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "callback": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "secret": {
          "type": "string",
          "minLength": 16
        }
      },
      "required": [
        "url",
        "secret"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "attemptId",
    "traceId",
    "connectionId",
    "workspaceId",
    "to",
    "from",
    "callerId",
    "tenantId",
    "contact",
    "campaign",
    "limits",
    "callback"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
