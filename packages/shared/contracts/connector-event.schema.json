{
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "providerAttemptId": {
      "type": "string",
      "minLength": 1
    },
    "attemptId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "enum": [
        "DELIVERY_CONFIRMED",
        "RESULT",
        "OPT_OUT",
        "RESULT_UNKNOWN"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "tabulationCode": {
      "type": "string"
    },
    "scheduledAt": {
      "type": "string",
      "format": "date-time"
    },
    "cost": {
      "type": "number",
      "minimum": 0
    },
    "aiCostUsd": {
      "type": "number",
      "minimum": 0
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "recordingUrl": {
      "type": "string",
      "format": "uri"
    },
    "amdResult": {
      "type": "string",
      "enum": [
        "HUMAN",
        "VOICEMAIL",
        "SILENCE",
        "UNKNOWN"
      ]
    },
    "extractedData": {
      "type": "object",
      "additionalProperties": {}
    },
    "intermediaryData": {
      "type": "object",
      "additionalProperties": {}
    },
    "latencyStats": {
      "type": "object",
      "properties": {
        "p50Ms": {
          "type": "number",
          "minimum": 0
        },
        "lastMs": {
          "type": "number",
          "minimum": 0
        },
        "maxMs": {
          "type": "number",
          "minimum": 0
        },
        "turnsCount": {
          "type": "integer",
          "minimum": 0
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "userEndAt": {
                "type": "number"
              },
              "aiStartAt": {
                "type": "number"
              },
              "responseMs": {
                "type": "number",
                "minimum": 0
              },
              "endpointingMs": {
                "type": "number",
                "minimum": 0
              },
              "aiTurnaroundMs": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "responseMs"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "providerAttemptId",
    "type",
    "occurredAt"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
