# API
DATABASE_URL=postgres://postgres:postgres@localhost:5432/voll_connect
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/voll_connect_test
API_PORT=3333
# URL pública da API (usada pelo conector simulado para entregar webhooks)
API_PUBLIC_URL=http://localhost:3333
# Mockup sem login: true = entra direto como Administrador (troca de perfil no menu do usuário)
AUTH_DISABLED=true
JWT_SECRET=troque-este-segredo-em-producao
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:5173
# Worker
WORKER_TICK_MS=2000
# Seed
SEED_ADMIN_EMAIL=admin@voll.local
SEED_ADMIN_PASSWORD=Voll@2026
# OpenAI API (Assistente Interativo de Campanhas)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Gateway de voz (apps/voice-gateway) usado pela conexão "Discador IA" do seed.
# Sem VOICE_APP_BASE_URL e VOICE_APP_CALLER_ID a conexão nasce inativa e nenhuma chamada sai.
VOICE_APP_BASE_URL=
VOICE_APP_TOKEN=
VOICE_APP_CALLER_ID=
# O gateway tem seu próprio .env: copie apps/voice-gateway/.env-example
