# ==== OPENAI REALTIME API ====
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_PROMPT_ID=
OPENAI_AGENT_INSTRUCTIONS="Você é um assistente de voz prestativo, ágil e conciso. Fale em português brasileiro de forma amigável."
OPENAI_VOICE=alloy
# Modo de áudio com a OpenAI: 'pcm24k' (padrão 24kHz interpolado) ou 'g711_ulaw' (8kHz nativo - 6x menos banda e menor uso de CPU)
AUDIO_CODEC_MODE=pcm24k

# ==== DETECTOR DE SECRETÁRIA (AMD) & TRANSCRIÇÃO (STT) ====
# Endereço dos nós do whisper-service (suporta múltiplos nós separados por vírgula para balanceamento de carga)
WHISPER_NODES=ws://127.0.0.1:8080/ws/audio
# AMD Opcional Global (true=ativo por padrão para todos os tenants | false=desligado)
AMD_DEFAULT_ENABLED=false
# Modo do AMD: 'active' (encerra a chamada ao detectar máquina/operadora) ou 'shadow' (apenas grava nos logs para treino)
AMD_DEFAULT_MODE=active
# STT Transcrição Opcional Global (true=transcreve frases do cliente durante a ligação | false=desligado)
STT_DEFAULT_ENABLED=false

# ==== TRAVAS DE SEGURANÇA, RATE LIMIT E BARGE-IN ====
MAX_CALL_DURATION_SEC=900
MAX_CONCURRENT_CALLS_PER_TENANT=200
MAX_CPS_PER_TENANT=30
BARGEIN_LEVEL=3
BARGEIN_GRACE_SEC=8

# ==== PONTE DE MÍDIA (mod_audio_fork <-> Node.js) ====
# Porta base HTTP/WS (Em cluster PM2, cada worker usa MEDIA_WS_PORT + WORKER_ID automaticamente: 8090, 8091...)
MEDIA_WS_PORT=8090
AUDIO_FORK_WS_HOST=127.0.0.1

# ==== DRACHTIO SIP SERVER ====
# Modo 'inbound' (srf.connect) ou 'outbound' (srf.listen para balanceamento multi-worker)
DRACHTIO_MODE=inbound
DRACHTIO_HOST=127.0.0.1
DRACHTIO_PORT=9022
DRACHTIO_SECRET=cymru
DRACHTIO_LISTEN_PORT=3000
DRACHTIO_EXTERNAL_IP=127.0.0.1

# ==== CLUSTER / POOL DE FREESWITCH (ESL) ====
# Para 1 única instância de FreeSWITCH:
FREESWITCH_HOST=127.0.0.1
FREESWITCH_PORT=8021
FREESWITCH_SECRET=JambonzR0ck$

# Para MÚLTIPLAS instâncias de FreeSWITCH em produção (balanceamento Least-Connections + Failover automático):
# Formato: host1:porta1:senha1,host2:porta2:senha2,host3:porta3:senha3
# FREESWITCH_NODES=192.168.15.36:8021:JambonzR0ck$,192.168.15.37:8021:JambonzR0ck$
FREESWITCH_MAX_CALLS_PER_NODE=600
